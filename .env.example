# Supabase configuration (Public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase configuration (Secret - Server-side only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cloudflare R2 configurations (Secret - Server-side only)
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-cloudflare-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-cloudflare-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=nuscas-assets
CLOUDFLARE_R2_PUBLIC_URL=https://pub-your-bucket-id.r2.dev

# Resend API Key (Secret - Server-side only)
RESEND_API_KEY=re_your_api_key

# Telegram Bot configurations (Secret & Public)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=your-random-webhook-secret-token
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your-telegram-bot-username
